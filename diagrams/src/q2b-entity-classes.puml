@startuml
!include _style.iuml
left to right direction
title Q2b – Biểu đồ lớp thực thể – hai module (Track Invoice 0 + Approve and Export Order 0)

class Member {
  -username
  -password
  -fullName
  -email
  -phone
  -address
}
class Customer {
  -code
}
class Staff {
  -code
  -position
}
class SaleStaff
class DeliveryStaff {
  -code
  -fullName
  -phone
  -area
  -status
}
class Order {
  -code
  -orderDate
  -shippingAddress
  -totalAmount
  -status
  -approvedAt
  -exportedAt
}
class OrderDetail {
  -quantity
  -unitPrice
  -lineAmount
}
class Product {
  -code
  -productName
  -unit
  -salePrice
  -stockQuantity
  -status
}
class Invoice {
  -code
  -issueDate
  -totalAmount
}

Customer "1" -- "0..*" Order : đặt >
SaleStaff "0..1" -- "0..*" Order : duyệt và xuất >
DeliveryStaff "0..1" -- "0..*" Order : được phân công >
Order "1" *-- "1..*" OrderDetail
OrderDetail "0..*" o-- "1" Product
Order "1" -- "1" Invoice : có >
Customer -up-|> Member
Staff -up-|> Member
SaleStaff -up-|> Staff
@enduml
