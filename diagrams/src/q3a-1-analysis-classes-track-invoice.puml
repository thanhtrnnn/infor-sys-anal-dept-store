@startuml
!include _style.iuml
title Q3a – Biểu đồ lớp phân tích – Module 1: Track Invoice 0

' Hàng trên: các lớp biên theo thứ tự giao diện
class CustomerHomeView {
  -subTrackInvoice
}
class InvoiceListView {
  -outsubInvoiceList
  -subBack
}
class InvoiceDetailView {
  -outInvoiceInfo
  -outsubItemList
  -outTotalAmount
  -outStatus
  -subBack
}
CustomerHomeView - InvoiceListView
InvoiceListView - InvoiceDetailView

' Hàng dưới: các lớp thực thể, giữ nguyên quan hệ của biểu đồ thực thể (Q2b)
class Invoice {
  -code
  -issueDate
  -totalAmount
  +getInvoiceByCustomer()
  +getInvoiceDetail()
}
class Order {
  -code
  -orderDate
  -shippingAddress
  -totalAmount
  -status
  -approvedAt
  -exportedAt
}
class OrderDetail {
  -quantity
  -unitPrice
  -lineAmount
}
class Product {
  -code
  -productName
  -unit
  -salePrice
  -stockQuantity
  -status
}
class Member {
  -username
  -password
  -fullName
  -email
  -phone
  -address
}
class Customer {
  -code
}
class DeliveryStaff {
  -code
  -fullName
  -phone
  -area
  -status
}

InvoiceListView -- Invoice
InvoiceDetailView -- Invoice

Customer "1" -- "0..*" Order
DeliveryStaff "0..1" -- "0..*" Order
Order "1" *-- "1..*" OrderDetail
OrderDetail "0..*" o-- "1" Product
Order "1" -- "1" Invoice
Customer -up-|> Member
@enduml
