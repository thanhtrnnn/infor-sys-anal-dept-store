@startuml
' Shared look for every diagram: plain black-and-white UML, course style.
skinparam shadowing false
skinparam monochrome false
skinparam defaultFontName "Arial"
skinparam defaultFontSize 12
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #000000
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #000000
  HeaderBackgroundColor #FFFFFF
}
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #000000
}
skinparam actorBorderColor #000000
skinparam actorBackgroundColor #FFFFFF
skinparam rectangleBorderColor #000000
skinparam packageBorderColor #000000
skinparam packageBackgroundColor #FFFFFF
skinparam packageStyle rectangle
skinparam nodeBackgroundColor #FFFFFF
skinparam artifactBackgroundColor #FFFFFF
skinparam databaseBackgroundColor #FFFFFF
skinparam componentBackgroundColor #FFFFFF
skinparam stateBackgroundColor #FFFFFF
skinparam stateBorderColor #000000
skinparam objectBackgroundColor #FFFFFF
skinparam objectBorderColor #000000
skinparam entityBackgroundColor #FFFFFF
skinparam boundaryBackgroundColor #FFFFFF
skinparam controlBackgroundColor #FFFFFF
skinparam noteBackgroundColor #FFFFF0
skinparam noteBorderColor #888888
skinparam titleFontSize 14
hide empty members
hide circle
left to right direction
title Q5b – Biểu đồ triển khai – mô hình MVC trên J2EE (JSP + DAO)

node "Máy khách (PC / điện thoại)\n<<device>>" as client {
  node "Trình duyệt web\n<<execution environment>>" as browser {
    artifact "HTML / CSS / JS\n(trang do JSP sinh ra)" as html
  }
}
node "Máy in hóa đơn\n<<device>>" as printer

node "Web Server\n<<device>>" as server {
  node "Apache Tomcat 10+ (Jakarta EE / J2EE web container)\n<<execution environment>>" as tomcat {
    artifact "deptstore.war" as war {
      component "View\ngdLogin.jsp, khachhang/gd*.jsp,\nnhanvienbanhang/gd*.jsp\n(hiển thị, gọi DAO)" as viewc
      component "Xử lí form\nnhanvienbanhang/do*.jsp, doLogin.jsp" as formc
      component "DAO\nWEB-INF/classes/dao (DAO, XxxDAO)" as daoc
      component "Model\nWEB-INF/classes/model\n(Order, Invoice, ...)" as modelc
      artifact "WEB-INF/lib/\nmysql-connector-j.jar" as driver
    }
  }
}
node "Database Server\n<<device>>" as dbserver {
  node "MySQL 8\n<<execution environment>>" as mysql {
    database "deptstore\n(11 bảng tbl*)" as db
  }
}

client -- server : 1: HTTP/HTTPS (port 8080/443)
server -- dbserver : 2: JDBC / TCP 3306
client -- printer : 3: in hóa đơn\n(window.print())
viewc ..> formc : submit form
viewc ..> daoc : gọi DAO
formc ..> daoc : gọi DAO
daoc ..> modelc : đóng gói thực thể
daoc ..> driver : JDBC
@enduml
